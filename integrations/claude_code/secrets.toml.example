# Copy this file to the repo root as `secrets.toml` and fill in the keys you need.
# `secrets.toml` is git-ignored. The runner and preflight load it into the
# environment automatically (override with --secrets <path>).

# ---- Required: Claude models (Anthropic API key, NOT the Claude Code login) ----
ANTHROPIC_API_KEY = "sk-ant-..."

# ---- Optional: override default model ids (else run_storm_claude defaults apply) ----
# STORM_CLAUDE_STRONG_MODEL = "anthropic/claude-sonnet-4-5"
# STORM_CLAUDE_FAST_MODEL   = "anthropic/claude-haiku-4-5"

# ---- Retriever keys (ONLY needed for the retriever you pick) ----
# The default retriever is DuckDuckGo, which needs no key.
# BING_SEARCH_API_KEY = "..."
# YDC_API_KEY         = "..."   # You.com
# SERPER_API_KEY      = "..."   # serper.dev
# BRAVE_API_KEY       = "..."
# TAVILY_API_KEY      = "..."
# SEARXNG_API_KEY     = "..."   # optional; only if your SearXNG instance needs it
